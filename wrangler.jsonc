{
  "$schema": "./cloudflare/node_modules/wrangler/config-schema.json",
  "name": "bindle-cash",
  "account_id": "b6d1478423f0bb0c0477df387305e46b",
  "compatibility_date": "2026-10-11",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/railgun-artifacts/railgun/poi/13x13/proving_key.bin.br.bin"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "main": "cloudflare/large-asset-worker.ts"
}
