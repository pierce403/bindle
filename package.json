{
  "name": "bindle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.1",
  "description": "A privacy centric Railgun wallet interface for Ethereum.",
  "scripts": {
    "preinstall": "node scripts/require-pnpm.mjs",
    "artifacts:railgun": "node scripts/mirror-railgun-artifacts.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "build:app": "tsc -b && vite build",
    "icons": "node scripts/generate-pwa-icons.mjs",
    "logo": "node scripts/generate-logo-source.mjs && node scripts/generate-pwa-icons.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@kohaku-eth/plugins": "0.0.1-alpha.8",
    "@kohaku-eth/provider": "0.1.0-alpha.8",
    "@kohaku-eth/railgun": "0.0.1-alpha.22",
    "@railgun-community/shared-models": "8.0.1",
    "@railgun-community/waku-broadcaster-client-web": "9.1.0",
    "@railgun-community/wallet": "10.8.6",
    "ethers": "6.14.3",
    "level-js": "6.1.0",
    "lucide-react": "1.17.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "snarkjs": "0.7.6",
    "viem": "2.45.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/level-js": "4.0.5",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "@types/snarkjs": "0.7.9",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vite-plugin-node-polyfills": "0.28.0"
  }
}
