{
  "name": "bindle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.1",
  "description": "A privacy centric Railgun wallet interface for Ethereum.",
  "scripts": {
    "preinstall": "node scripts/require-pnpm.mjs",
    "artifacts:railgun": "node scripts/mirror-railgun-artifacts.mjs",
    "artifacts:verify": "node scripts/verify-railgun-artifacts.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "build:app": "tsc -b && vite build",
    "icons": "node scripts/generate-pwa-icons.mjs",
    "logo": "node scripts/generate-logo-source.mjs && node scripts/generate-pwa-icons.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "scan:waku": "node scripts/scan-kohaku-waku-relays.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@kohaku-eth/plugins": "0.0.1-alpha.8",
    "@kohaku-eth/provider": "0.1.0-alpha.8",
    "@kohaku-eth/railgun": "0.0.1-alpha.22",
    "@kohaku-eth/railgun-waku": "npm:@kohaku-eth/railgun@0.0.1-alpha.12",
    "@waku/sdk": "0.0.36",
    "ethers": "6.14.3",
    "lucide-react": "1.17.0",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "viem": "2.45.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "6.0.3",
    "vite": "8.0.16"
  },
  "pnpm": {
    "overrides": {
      "underscore": "1.13.8",
      "uuid": "11.1.1",
      "ws": "8.20.1"
    }
  }
}
